//====================1.基因工程底层结构====================
enum DNABase { A, T, C, G };
struct GeneSegment
{
    std::vector<DNABase> bases;
    std::string trait;
    float weight;
};
struct Genome
{
    std::vector<GeneSegment> geneList;
    float evolveRate = 0.001f;
    long long version = 1;
};

class GeneEngine
{
public:
    Genome genome;
    std::mt19937 rng;

    GeneEngine() { rng.seed((unsigned)time(nullptr)); InitBaseGene(); }

    void InitBaseGene()
    {
        genome.geneList.push_back({{A, T, C, G}, "skeleton", 1.0f});
        genome.geneList.push_back({{C, G, A, T}, "nerve", 1.0f});
        genome.geneList.push_back({{T, A, G, C}, "motion", 1.0f});
    }

    //AI自主基因变异进化
    void AISelfMutate()
    {
        std::uniform_real_distribution<float> dist(-genome.evolveRate, genome.evolveRate);
        for (auto& seg : genome.geneList)
        {
            seg.weight += dist(rng);
            seg.weight = glm::clamp(seg.weight, 0.2f, 2.5f);
        }
        genome.version++;
    }

    float GetTraitWeight(const std::string& tag)
    {
        for (auto& s : genome.geneList)
            if (s.trait == tag) return s.weight;
        return 1.0f;
    }
};

//====================2.仿生躯体控制器====================
struct Joint
{
    float angle = 0.f;
    glm::vec3 offset;
};

class BodyController
{
public:
    std::vector<Joint> joints;
    float bodyScale = 1.f;
    float reactSpeed = 1.f;

    BodyController()
    {
        joints.resize(16);
    }

    //基因驱动躯体参数更新
    void UpdateFromGene(GeneEngine& ge)
    {
        bodyScale = ge.GetTraitWeight("skeleton");
        reactSpeed = ge.GetTraitWeight("nerve");
    }

    //AI驱动关节动作
    void UpdateAction(std::vector<float> actData, float dt)
    {
        for (int i = 0; i < joints.size() && i < actData.size(); i++)
        {
            joints[i].angle += actData[i] * reactSpeed * dt;
        }
    }
};

//====================3.AI自主决策核心====================
class AICore
{
public:
    std::vector<float> Decide(float envVal, GeneEngine& ge)
    {
        std::vector<float> res(16, 0.f);
        float motionW = ge.GetTraitWeight("motion");
        for (int i = 0; i < 16; i++)
        {
            res[i] = (envVal - 0.5f) * motionW * 0.4f;
        }
        return res;
    }

    void SelfEvolve(GeneEngine& ge)
    {
        ge.AISelfMutate();
    }
};

//====================4.仿生生态模拟系统====================
class EcoSystem
{
public:
    float timeTick = 0.f;
    float envFactor = 0.5f;
    float lastEvolve = 0.f;

    void Tick(float dt, AICore& ai, GeneEngine& ge, BodyController& body)
    {
        timeTick += dt;
        envFactor = std::sin(timeTick * 0.2f) * 0.3f + 0.5f;

        //定时AI进化
        if (timeTick - lastEvolve > 25.f)
        {
            lastEvolve = timeTick;
            ai.SelfEvolve(ge);
            body.UpdateFromGene(ge);
        }
    }
    float GetEnv() { return envFactor; }
};

//====================5.720°全景三维渲染====================
glm::vec3 camPos(0, 3, 10);
float yaw = 0.f, pitch = 0.f, roll = 0.f;

void UpdateCamera(float dt)
{
    yaw += dt * 0.25f;
    pitch += dt * 0.08f;
    roll += dt * 0.03f;
}

void DrawBody(BodyController& body, glm::mat4 proj, glm::mat4 view)
{
    glm::mat4 model = glm::mat4(1.f);
    model = glm::scale(model, glm::vec3(body.bodyScale));
    glMatrixMode(GL_PROJECTION);
    glLoadMatrixf(glm::value_ptr(proj));
    glMatrixMode(GL_MODELVIEW);
    glLoadMatrixf(glm::value_ptr(view * model));

    //躯干
    glBegin(GL_QUADS);
    glColor3f(0.3f, 0.6f, 0.9f);
    glVertex3f(-0.4f, 0.f, 0.f);
    glVertex3f(0.4f, 0.f, 0.f);
    glVertex3f(0.4f, 2.f, 0.f);
    glVertex3f(-0.4f, 2.f, 0.f);
    glEnd();

    //关节肢体简易渲染
    for (int i = 0; i < 8; i++)
    {
        glPushMatrix();
        glRotatef(body.joints[i].angle, 0, 0, 1);
        glColor3f(0.9f, 0.4f, 0.4f);
        glBegin(GL_QUADS);
        glVertex3f(0, 2.f, 0);
        glVertex3f(0.2f, 2.f, 0);
        glVertex3f(0.2f, 3.2f, 0);
        glVertex3f(0, 3.2f, 0);
        glEnd();
        glPopMatrix();
    }
}

void DrawWorld(glm::mat4 proj, glm::mat4 view)
{
    glMatrixMode(GL_PROJECTION);
    glLoadMatrixf(glm::value_ptr(proj));
    glMatrixMode(GL_MODELVIEW);
    glLoadMatrixf(glm::value_ptr(view));

    //地面
    glColor3f(0.2f, 0.35f, 0.2f);
    glBegin(GL_QUADS);
    glVertex3f(-30, 0, -30);
    glVertex3f(30, 0, -30);
    glVertex3f(30, 0, 30);
    glVertex3f(-30, 0, 30);
    glEnd();

    //全景环境围墙
    glColor3f(0.15f, 0.18f, 0.22f);
    glBegin(GL_LINE_LOOP);
    for (int i = 0; i <= 360; i += 15)
    {
        float rad = glm::radians((float)i);
        glVertex3f(std::cos(rad) * 28, 12, std::sin(rad) * 28);
    }
    glEnd();
}

//====================程序入口主循环====================
int main()
{
    if (!glfwInit()) return -1;
    GLFWwindow* win = glfwCreateWindow(1280,720,"BioAI 720°Eco Sim",nullptr,nullptr);
    glfwMakeContextCurrent(win);
    gladLoadGLLoader((GLADloadproc)glfwGetProcAddress);

    GeneEngine gene;
    BodyController body;
    AICore ai;
    EcoSystem eco;

    float lastTime = (float)glfwGetTime();

    while (!glfwWindowShouldClose(win))
    {
        float now = (float)glfwGetTime();
        float dt = now - lastTime;
        lastTime = now;

        glClearColor(0.05f,0.07f,0.11f,1.f);
        glClear(GL_COLOR_BUFFER_BIT | GL_DEPTH_BUFFER_BIT);
        glEnable(GL_DEPTH_TEST);

        //生态迭代
        eco.Tick(dt, ai, gene, body);
        //AI决策驱动躯体
        auto act = ai.Decide(eco.GetEnv(), gene);
        body.UpdateAction(act, dt);

        //720度相机更新
        UpdateCamera(dt);
        glm::mat4 proj = glm::perspective(glm::radians(70.f),1280.f/720.f,0.1f,120.f);
        glm::mat4 view = glm::lookAt(camPos,glm::vec3(0,2,0),glm::vec3(0,1,0));
        view = glm::rotate(view,glm::radians(yaw),glm::vec3(0,1,0));
        view = glm::rotate(view,glm::radians(pitch),glm::vec3(1,0,0));
        view = glm::rotate(view,glm::radians(roll),glm::vec3(0,0,1));

        DrawWorld(proj,view);
        DrawBody(body,proj,view);

        glfwSwapBuffers(win);
        glfwPollEvents();
    }
    glfwTerminate();
    return 0;
}
