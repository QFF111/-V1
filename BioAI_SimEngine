3.12 场景渲染模块 Render/SceneRender.cpp
#include "SceneRender.h"
#include <glm/gtc/type_ptr.hpp>
#include <cmath>

// 绘制地面、全景环形生态边界
void SceneRender::DrawWorld(glm::mat4 proj, glm::mat4 view)
{
    glMatrixMode(GL_PROJECTION);
    glLoadMatrixf(glm::value_ptr(proj));
    glMatrixMode(GL_MODELVIEW);
    glLoadMatrixf(glm::value_ptr(view));

    // 草地地面
    glColor3f(0.2f, 0.35f, 0.2f);
    glBegin(GL_QUADS);
    glVertex3f(-30, 0, -30);
    glVertex3f(30, 0, -30);
    glVertex3f(30, 0, 30);
    glVertex3f(-30, 0, 30);
    glEnd();

    // 360°全景环境围墙边界
    glColor3f(0.15f, 0.18f, 0.22f);
    glBegin(GL_LINE_LOOP);
    for (int i = 0; i <= 360; i += 15)
    {
        float rad = glm::radians((float)i);
        glVertex3f(std::cos(rad) * 28, 12, std::sin(rad) * 28);
    }
    glEnd();
}

// 根据基因缩放参数、关节角度，动态绘制仿生躯体
void SceneRender::DrawBody(BodyController& body, glm::mat4 proj, glm::mat4 view)
{
    glm::mat4 model = glm::mat4(1.f);
    model = glm::scale(model, glm::vec3(body.bodyScale));
    glMatrixMode(GL_PROJECTION);
    glLoadMatrixf(glm::value_ptr(proj));
    glMatrixMode(GL_MODELVIEW);
    glLoadMatrixf(glm::value_ptr(view * model));

    // 躯干主体
    glBegin(GL_QUADS);
    glColor3f(0.3f, 0.6f, 0.9f);
    glVertex3f(-0.4f, 0.f, 0.f);
    glVertex3f(0.4f, 0.f, 0.f);
    glVertex3f(0.4f, 2.f, 0.f);
    glVertex3f(-0.4f, 2.f, 0.f);
    glEnd();

    // 四肢关节动态渲染
    for (int i = 0; i < 8; i++)
    {
        glPushMatrix();
        glRotatef(body.joints[i].angle, 0, 0, 1);
        glColor3f(0.9f, 0.4f, 0.4f);
        glBegin(GL_QUADS);
        glVertex3f(0, 2.f, 0);
        glVertex3f(0.2f, 2.f, 0);
        glVertex3f(0.2f, 3.2f, 0);
        glVertex3f(0, 3.2f, 0);
        glEnd();
        glPopMatrix();
    }
}
3.13 程序入口 main.cpp
#include <glad/glad.h>
#include <GLFW/glfw3.h>
#include <glm/glm.hpp>
#include <glm/gtc/matrix_transform.hpp>
#include "Core/GeneEngine.h"
#include "Core/AICore.h"
#include "Core/BodyController.h"
#include "Core/EcoSystem.h"
#include "Render/PanoramicCamera.h"
#include "Render/SceneRender.h"

int main()
{
    // 初始化GLFW窗口
    if (!glfwInit()) return -1;
    GLFWwindow* win = glfwCreateWindow(1280, 720, "BioAI 720° Eco Genetic Sim", nullptr, nullptr);
    glfwMakeContextCurrent(win);
    gladLoadGLLoader((GLADloadproc)glfwGetProcAddress);

    // 实例化所有核心模块
    GeneEngine gene;
    BodyController body;
    AICore ai;
    EcoSystem eco;
    PanoramicCamera cam;
    SceneRender render;

    float lastTime = (float)glfwGetTime();

    // 主循环：帧更新+渲染闭环
    while (!glfwWindowShouldClose(win))
    {
        // 计算帧间隔时间
        float now = (float)glfwGetTime();
        float dt = now - lastTime;
        lastTime = now;

        // 画布清空与深度测试开启
        glClearColor(0.05f, 0.07f, 0.11f, 1.f);
        glClear(GL_COLOR_BUFFER_BIT | GL_DEPTH_BUFFER_BIT);
        glEnable(GL_DEPTH_TEST);

        // 1.生态环境迭代更新
        eco.Tick(dt, ai, gene, body);
        // 2.AI感知环境，输出躯体动作指令
        auto act = ai.Decide(eco.GetEnv(), gene);
        // 3.躯体执行动态动作
        body.UpdateAction(act, dt);
        // 4.全景相机角度更新
        cam.Update(dt);

        // 投影矩阵+视图矩阵计算
        glm::mat4 proj = glm::perspective(glm::radians(70.f), 1280.f / 720.f, 0.1f, 120.f);
        glm::mat4 view = cam.GetViewMatrix();

        // 渲染场景与仿生躯体
        render.DrawWorld(proj, view);
        render.DrawBody(body, proj, view);

        // 缓冲区刷新+事件监听
        glfwSwapBuffers(win);
        glfwPollEvents();
    }

    glfwTerminate();
    return 0;
}
